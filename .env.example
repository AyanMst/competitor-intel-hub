# Backend environment (copy to .env). Never commit real values.

# OpenAI: Whisper transcription, LLM analysis, embeddings
OPENAI_API_KEY=

# Supabase (service role key bypasses RLS: backend only, never expose to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CORS: the single allowed frontend origin
FRONTEND_URL=http://localhost:3000

# Stripe paywall (optional locally; use test-mode keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_LINK_URL=

# Slack alerts for notable changes (optional)
SLACK_WEBHOOK_URL=

# Crash reporting (optional, no-op when empty)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
